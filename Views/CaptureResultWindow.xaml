<Window x:Class="AreaShot.Views.CaptureResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AreaShot.Core.Localization;assembly=AreaShot.Core"
        xmlns:v="clr-namespace:AreaShot.Views"
        Title="{x:Static l:Strings.CaptureResultTitle}"
        Width="460" Height="430"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        FontFamily="{x:Static v:UiFont.Family}" FontSize="13"
        Background="#F3F3F3">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <!-- 閉じるは上段の右。よく使うコピーは最下段に横幅いっぱいで置き、マウスを離した点の真下に来るようにする（仕様書 §6） -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.ResultClose}" IsCancel="True" Click="OnCloseClick"
                    Height="26" Margin="4,0" HorizontalContentAlignment="Center" />
            <TextBlock x:Name="SizeText" Margin="4,0" VerticalAlignment="Center" Foreground="#444" />
        </DockPanel>
        <Button x:Name="CopyButton" DockPanel.Dock="Bottom" Content="{x:Static l:Strings.ResultCopy}" IsDefault="True" Click="OnCopy"
                Height="40" FontWeight="SemiBold" HorizontalContentAlignment="Center" />
        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
            <Button Content="{x:Static l:Strings.ResultEdit}" Click="OnEdit" />
            <Button x:Name="SaveButton" Content="{x:Static l:Strings.ResultSave}" Click="OnSave" />
            <Button Content="{x:Static l:Strings.ResultSaveAs}" Click="OnSaveAs" />
            <Button Content="{x:Static l:Strings.ResultRetry}" Click="OnRetry" />
        </UniformGrid>
        <Border Background="#E0E0E0" BorderBrush="#C8C8C8" BorderThickness="1" Margin="4,0">
            <Image x:Name="Preview" Stretch="Uniform" StretchDirection="DownOnly" Margin="6"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
    </DockPanel>
</Window>
