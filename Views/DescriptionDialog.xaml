<Window x:Class="AreaShot.Views.DescriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AreaShot.Core.Localization;assembly=AreaShot.Core"
        xmlns:v="clr-namespace:AreaShot.Views"
        Title="{x:Static l:Strings.DescriptionTitle}"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        FontFamily="{x:Static v:UiFont.Family}" FontSize="13"
        Background="#F3F3F3">
    <StackPanel Margin="14">
        <TextBlock Text="{x:Static l:Strings.DescriptionLabel}" Margin="0,0,0,3" />
        <TextBox x:Name="DescriptionBox" VerticalContentAlignment="Center" Height="28" TextChanged="OnDescriptionChanged" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{x:Static l:Strings.DescriptionFolder}" Foreground="#444" Margin="0,0,8,0" />
            <v:CompactPathText x:Name="FolderText" Grid.Row="0" Grid.Column="1" Foreground="#444" />
            <TextBlock Grid.Row="1" Text="{x:Static l:Strings.DescriptionName}" Margin="0,4,8,0" />
            <TextBlock x:Name="NameText" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Grid>
        <!-- 入力の誤り・番号の変更は折りたたまずに出す。 -->
        <TextBlock x:Name="MessageText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#C00000" Visibility="Collapsed" />
        <TextBlock Text="{x:Static l:Strings.DescriptionOptional}" Margin="0,8,0,0" Foreground="#666" FontSize="12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="{x:Static l:Strings.DescriptionSave}" MinWidth="96" Padding="10,0" Height="30" IsDefault="True" Click="OnSave" />
            <Button Content="{x:Static l:Strings.DescriptionCancel}" MinWidth="96" Padding="10,0" Height="30" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
